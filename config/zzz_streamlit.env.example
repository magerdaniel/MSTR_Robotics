# Streamlit Application Environment Variables
# Copy this file to streamlit.env and fill in your actual values

# API Server Configuration
API_SERVER_HOST=localhost
API_SERVER_PORT=8000
API_SERVER_BASE_URL=http://${API_SERVER_HOST}:${API_SERVER_PORT}

# MicroStrategy Connection Settings
MSTR_BASE_URL=http://your-mstr-server:8080/MicroStrategyLibrary/api
MSTR_USERNAME=your-username
MSTR_PASSWORD=your-password

# Default Object Loader Settings
DEFAULT_REDIS_KEY=DOCUMENT_DEFINITION:your-object-id-here
